{
  "input": {
    "video_extensions": [".mp4", ".mov"],
    "transcript_patterns": ["transcript.txt", "<video-stem>.txt", "<video-stem>.vtt", "<video-stem>.srt"],
    "preserve_originals": true
  },
  "transcripts": {
    "policy": "prefer_existing",
    "timestamp_detection": "auto",
    "whisper": {
      "enabled": "on_demand",
      "engine": "faster-whisper",
      "model": "base",
      "device": "cpu",
      "compute_type": "int8",
      "word_timestamps": true,
      "never_replace_original": true
    }
  },
  "model_gateway": {
    "type": "existing_self_hosted_litellm",
    "url_env": "LITELLM_PROXY_API_BASE",
    "key_env": "LITELLM_PROXY_API_KEY",
    "models": {
      "reasoning": "meeting-reasoning",
      "vision": "meeting-vision",
      "text_embedding": "meeting-text-embedding",
      "video_embedding": "meeting-video-embedding"
    },
    "aliases_are_examples_not_verified": true,
    "enforce_stable_embedding_model": true,
    "disable_embedding_fallback_between_models": true
  },
  "video": {
    "primary_provider": "videodb",
    "alternative_provider": "hybrid",
    "alternative_engine": "sentrysearch",
    "alternative_embedding_backend": "litellm",
    "video_embedding_compatibility": "not_verified",
    "video_embedding_required_for_full_visual_retrieval": true
  },
  "text_retrieval": {
    "primary": "keyword",
    "semantic_via_gateway": "optional_after_validation"
  },
  "privacy": {
    "azure_inference_is_remote": true,
    "source_video_upload_requires_approval": true,
    "no_public_repo_media_or_secrets": true
  },
  "experiments": {
    "process_entire_library": "disabled_until_one_recording_validated",
    "bypass_litellm": "disabled"
  }
}
